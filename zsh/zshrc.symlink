source $HOME/.dotfiles/powerline/paths.zsh

# pipenv
source $HOME/.dotfiles/zsh/pipenv.zsh

# tensorrt
# https://docs.nvidia.com/deeplearning/tensorrt/install-guide/index.html#installing-tar
