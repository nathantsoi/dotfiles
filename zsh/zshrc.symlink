## batali
#source ~/.aws_keys

# brew
if [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# homebrew-cask
#export HOMEBREW_CASK_OPTS="--appdir=/Applications"



# oh-my-zsh
plugins=(rails git ruby osx rake brew adb tmux tmuxinator z colored-man-pages)
export ZSH=$HOME/.dotfiles/zsh/oh-my-zsh
ZSH_DISABLE_COMPFIX="true"
source $ZSH/oh-my-zsh.sh

# shortcut to this dotfiles path is $ZSH
export ZSH=$HOME/.dotfiles

## your project folder that we can `c [tab]` to
#export PROJECTS=~/src

## ROS
#ROS_SETUP=/opt/ros/indigo/setup.zsh
#[ -f $ROS_SETUP ] && source $ROS_SETUP

## Openni
#export OPENNI2_INCLUDE=/usr/local/include/ni2
#export OPENNI2_REDIST=/usr/local/lib/ni2

# NXP examples and px4
# Note: ARMGCC_DIR is now defined in user-config.zsh
path_prepend_if_exists "$ARMGCC_DIR/bin"

## Zephyr
#export ZEPHYR_BASE=$HOME/src/embedded/zephyr/
#[ -f $ZEPHYR_BASE/zephyr-env.sh ] && source $ZEPHYR_BASE/zephyr-env.sh

# use .localrc for SUPER SECRET CRAP that you don't
# want in your public, versioned repo.
if [[ -a ~/.localrc ]]
then
  source ~/.localrc
fi

# all of our zsh files
typeset -U config_files
config_files=($ZSH/**/*.zsh)

# load the path files
for file in ${(M)config_files:#*/path.zsh}
do
  source $file
done

# load everything but the path and completion files and oh-my-zsh
for file in ${${config_files:#*/path.zsh}:#*/completion.zsh}
do
  case "$file" in
    */oh-my-zsh/*|*/vim.symlink/*) continue ;;
  esac
  source $file
done

# initialize autocomplete here, otherwise functions won't be loaded
autoload -U compinit
compinit -d "${ZDOTDIR:-$HOME}/.zcompdump-${ZSH_VERSION}"

# load every completion after autocomplete loads
for file in ${(M)config_files:#*/completion.zsh}
do
  case "$file" in
    */oh-my-zsh/*|*/vim.symlink/*) continue ;;
  esac
  source $file
done

unset config_files

