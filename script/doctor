#!/usr/bin/env bash
#
# Validate the dotfiles setup after script/setup.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=deferred.lib
source "$DOTFILES_ROOT/script/deferred.lib"

echo "Dotfiles doctor"
echo

echo "Script syntax"
bash -n \
  "$DOTFILES_ROOT/script/setup" \
  "$DOTFILES_ROOT/script/deferred-report" \
  "$DOTFILES_ROOT/script/deferred.lib" \
  "$DOTFILES_ROOT/debian/install.sh" \
  "$DOTFILES_ROOT/font/install.sh" \
  "$DOTFILES_ROOT/fzf/install.sh" \
  "$DOTFILES_ROOT/homebrew/install.sh" \
  "$DOTFILES_ROOT/mirror/install.sh" \
  "$DOTFILES_ROOT/powerline/install.sh" \
  "$DOTFILES_ROOT/python/install.sh" \
  "$DOTFILES_ROOT/ruby/install.sh" \
  "$DOTFILES_ROOT/tmux/install.sh" \
  "$DOTFILES_ROOT/vim/install.sh"
echo "  ok bash scripts"

if command -v zsh >/dev/null 2>&1; then
  zsh -n \
    "$DOTFILES_ROOT/zsh/zshrc.symlink" \
    "$DOTFILES_ROOT/zsh/config.zsh" \
    "$DOTFILES_ROOT/zsh/aliases.zsh" \
    "$DOTFILES_ROOT/zsh/completion.zsh" \
    "$DOTFILES_ROOT/zsh/help.zsh" \
    "$DOTFILES_ROOT/zsh/prompt.zsh" \
    "$DOTFILES_ROOT/powerline/paths.zsh"
  echo "  ok zsh files"
else
  echo "  miss zsh"
fi

echo
echo "Interactive shell"
if command -v zsh >/dev/null 2>&1; then
  zsh -i -c 'shell-help intro >/dev/null; shell-doctor' || echo "  zsh interactive check failed; run script/setup first"
else
  echo "  zsh unavailable; run script/setup first"
fi

echo
echo "Install mode"
mode_file="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install-mode"
if [[ -s "$mode_file" ]]; then
  mode="$(cat "$mode_file" 2>/dev/null || true)"
  case "$mode" in
    sudo) echo "  sudo (system packages via apt/Homebrew; sudo required to update)" ;;
    user) echo "  user-local (no sudo; updates stay user-local)" ;;
    *)    echo "  unknown: '$mode'" ;;
  esac
else
  echo "  not recorded yet (run script/setup to record)"
fi

echo
echo "Deferred (not installed; would improve UX)"
print_deferred_report
