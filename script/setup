#!/usr/bin/env bash
#
# Full dotfiles setup: system packages, symlinks, shell integration, topic installers.
#
# Install mode is sticky. The first run records whether it installed with sudo
# (system packages via apt/Homebrew + `chsh`) or user-locally (no root). Later
# runs reuse that mode so an install stays consistent: a no-root install never
# suddenly starts touching system packages just because sudo became available,
# and a sudo install requires sudo to update its system packages. Override or
# reset the recorded mode with DOTFILES_INSTALL_MODE=sudo|user (or delete the
# mode file). Without sudo, setup installs what it can user-locally and records
# the rest in a deferred-items report printed at the end and via `script/doctor`.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OS="$(uname -s)"

# shellcheck source=deferred.lib
source "$DOTFILES_ROOT/script/deferred.lib"

# Setup runs in bash, not zsh, so the user-local bin dir that zshrc adds to PATH
# isn't loaded. Prepend it so `have` checks see tools we install there (static
# binaries) and pipx-managed CLIs (powerline, httpie, uv, yt-dlp, ...).
mkdir -p "$HOME/.local/bin"
PATH="$HOME/.local/bin:$PATH"
export PATH

info() {
  printf "  [ \033[00;34m..\033[0m ] %s\n" "$1"
}

user() {
  printf "  [ \033[0;33m?\033[0m ] %s " "$1"
}

success() {
  printf "  [ \033[00;32mOK\033[0m ] %s\n" "$1"
}

warn() {
  printf "  [ \033[0;33m!!\033[0m ] %s\n" "$1"
}

fail() {
  printf "  [\033[0;31mFAIL\033[0m] %s\n" "$1"
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

# Privilege / install-mode state, populated by detect_privileges() and
# resolve_install_mode(). See the file header for the sticky-mode rationale.
HAS_SUDO=false
CAN_APT=false
INSTALL_MODE=""   # "sudo" | "user"
MODE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/install-mode"

detect_privileges() {
  HAS_SUDO=false
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    HAS_SUDO=true
  elif have sudo && sudo -n true 2>/dev/null; then
    HAS_SUDO=true
  fi

  CAN_APT=false
  if [[ "$OS" == "Linux" && "$HAS_SUDO" == true ]] && have apt-get; then
    CAN_APT=true
  fi
}

# Decide, persist, and enforce the install mode. Order of precedence:
#   1. DOTFILES_INSTALL_MODE=sudo|user  (explicit override; rewrites marker)
#   2. the recorded mode in $MODE_FILE  (sticky: reuse the original install)
#   3. current privileges               (first run: sudo if available, else user)
# In "user" mode sudo is forcibly ignored so the install stays user-local; in
# "sudo" mode sudo is required (the run aborts if it is unavailable).
resolve_install_mode() {
  local mode=""

  if [[ -n "${DOTFILES_INSTALL_MODE:-}" ]]; then
    case "$DOTFILES_INSTALL_MODE" in
      sudo|user) mode="$DOTFILES_INSTALL_MODE" ;;
      *) warn "ignoring invalid DOTFILES_INSTALL_MODE='$DOTFILES_INSTALL_MODE' (want: sudo|user)" ;;
    esac
  fi

  if [[ -z "$mode" && -s "$MODE_FILE" ]]; then
    mode="$(cat "$MODE_FILE" 2>/dev/null || true)"
    case "$mode" in
      sudo|user) ;;
      *) mode="" ;;
    esac
  fi

  if [[ -z "$mode" ]]; then
    if [[ "$HAS_SUDO" == true ]]; then
      mode="sudo"
    else
      mode="user"
    fi
  fi

  mkdir -p "$(dirname "$MODE_FILE")"
  printf '%s\n' "$mode" > "$MODE_FILE"
  INSTALL_MODE="$mode"

  if [[ "$INSTALL_MODE" == "sudo" ]]; then
    if [[ "$HAS_SUDO" != true ]]; then
      fail "This dotfiles install was originally set up with sudo, so sudo is required to update it. Run 'sudo -v' first, then re-run 'script/setup'. (To switch to a no-root install instead: DOTFILES_INSTALL_MODE=user script/setup)"
    fi
  else
    # user mode: never use sudo even if available, to keep the install
    # consistent with the original no-root setup.
    HAS_SUDO=false
    CAN_APT=false
  fi
}

run_as_root() {
  if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
    "$@"
  else
    sudo -n "$@"
  fi
}

apt_install_one() {
  local package="$1"
  if run_as_root apt-get install -y "$package"; then
    return 0
  fi
  warn "apt package unavailable: $package"
  defer "apt" "$package" "unavailable in apt" "try Homebrew (brew install $package) or a static binary"
  return 1
}

install_homebrew() {
  if have brew; then
    return 0
  fi

  if [[ "$HAS_SUDO" != true ]]; then
    warn "Homebrew not installed and no sudo available; skipping (brew packages deferred)"
    return 1
  fi

  info "installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  have brew || fail "Homebrew installed, but brew is not on PATH"
}

install_macos_packages() {
  if ! have brew; then
    install_homebrew || true
  fi

  if ! have brew; then
    warn "Homebrew unavailable; deferring brew packages"
    defer_macos_tools
    return
  fi

  local packages=(
    awscli
    bash
    bat
    bottom
    cmake
    coreutils
    direnv
    duf
    dust
    eza
    fd
    ffmpeg
    fzf
    gh
    git
    git-delta
    gnu-sed
    grc
    httpie
    imagemagick
    jq
    ncdu
    node
    nvm
    pipx
    pipenv
    python@3.13
    pyenv
    rclone
    rbenv
    readline
    ripgrep
    shellcheck
    shfmt
    sqlite
    the_silver_searcher
    tlrc
    tmux
    tree
    uv
    watchman
    yq
    yt-dlp
    zsh
  )

  local missing=()
  local package
  for package in "${packages[@]}"; do
    if ! brew list --formula "$package" >/dev/null 2>&1; then
      missing+=("$package")
    fi
  done

  if ! brew list --formula vim >/dev/null 2>&1 && ! brew list --formula macvim >/dev/null 2>&1; then
    missing+=(vim)
  fi

  if (( ${#missing[@]} )); then
    info "installing missing Homebrew packages: ${missing[*]}"
    brew install "${missing[@]}"
  else
    success "Homebrew packages already installed"
  fi

  local cask
  for cask in font-inconsolata font-jetbrains-mono-nerd-font miniforge; do
    if ! brew list --cask "$cask" >/dev/null 2>&1; then
      brew install --cask "$cask" || {
        warn "could not install $cask cask"
        defer "brew-cask" "$cask" "not installed" "brew install --cask $cask"
      }
    fi
  done
}

defer_macos_tools() {
  # label|binary  — defer brew formulae that aren't on PATH when Homebrew is
  # unavailable (no sudo to install it). Remedy points at installing Homebrew.
  local entries=(
    "zsh|zsh" "vim|vim" "tmux|tmux" "git|git" "fzf|fzf" "ripgrep|rg"
    "fd|fd" "bat|bat" "eza|eza" "jq|jq" "yq|yq" "tree|tree" "direnv|direnv"
    "duf|duf" "dust|dust" "ncdu|ncdu" "bottom|btm" "shellcheck|shellcheck"
    "shfmt|shfmt" "gh|gh" "git-delta|delta" "httpie|http" "tlrc|tldr"
    "node|node" "nvm|nvm" "uv|uv" "pyenv|pyenv" "rbenv|rbenv" "pipx|pipx"
    "pipenv|pipenv" "ffmpeg|ffmpeg" "imagemagick|magick" "awscli|aws"
    "rclone|rclone" "yt-dlp|yt-dlp" "watchman|watchman" "sqlite|sqlite3"
  )
  local entry label bin
  for entry in "${entries[@]}"; do
    IFS='|' read -r label bin <<< "$entry"
    if have "$bin"; then continue; fi
    defer "brew" "$label" "not installed" "install Homebrew (https://brew.sh, requires sudo), then: brew install $label"
  done
}

install_linux_packages() {
  if [[ "$CAN_APT" != true ]]; then
    if ! have apt-get; then
      warn "no apt-get; skipping system packages (recorded for manual install)"
    else
      warn "no sudo available; skipping apt packages (recorded for manual install)"
    fi
    return
  fi

  local required=(
    bash
    build-essential
    ca-certificates
    cmake
    curl
    fontconfig
    fonts-powerline
    fonts-firacode
    fzf
    git
    jq
    pipx
    python3
    python3-pip
    python3-venv
    ripgrep
    tmux
    tree
    unzip
    vim
    zsh
  )

  local optional=(
    bat
    bottom
    direnv
    duf
    dust
    eza
    exa
    ffmpeg
    fd-find
    gh
    git-delta
    httpie
    imagemagick
    ncdu
    nodejs
    npm
    postgresql-client
    rclone
    shellcheck
    shfmt
    silversearcher-ag
    sqlite3
    tldr
    uv
    watchman
    yq
    yt-dlp
  )

  info "installing apt packages"
  run_as_root apt-get update

  local package
  for package in "${required[@]}"; do
    apt_install_one "$package" || true
  done

  for package in "${optional[@]}"; do
    apt_install_one "$package" || true
  done
}

# Record user-facing tools that are still missing on Linux, with a remediation
# hint. Covers both the no-sudo case (everything apt would have provided) and
# packages apt couldn't provide. Runs after the apt step (or in its place).
defer_missing_linux_tools() {
  [[ "$OS" == "Linux" ]] || return 0

  # label|binary(s)|apt_pkg|category
  local entries=(
    "zsh|zsh|zsh|required"
    "vim|vim|vim|required"
    "tmux|tmux|tmux|required"
    "git|git|git|required"
    "fzf|fzf|fzf|required"
    "ripgrep|rg|ripgrep|optional"
    "fd|fd fdfind|fd-find|optional"
    "bat|bat batcat|bat|optional"
    "eza|eza exa|eza|optional"
    "jq|jq|jq|optional"
    "yq|yq|yq|optional"
    "tree|tree|tree|optional"
    "direnv|direnv|direnv|optional"
    "duf|duf|duf|optional"
    "dust|dust|dust|optional"
    "ncdu|ncdu|ncdu|optional"
    "bottom|btm|bottom|optional"
    "shellcheck|shellcheck|shellcheck|optional"
    "shfmt|shfmt|shfmt|optional"
    "gh|gh|gh|optional"
    "git-delta|delta|git-delta|optional"
    "httpie|http|httpie|optional"
    "tldr|tldr tlrc|tldr|optional"
    "node|node|nodejs|optional"
    "npm|npm|npm|optional"
    "uv|uv|uv|optional"
    "imagemagick|magick convert|imagemagick|optional"
    "ffmpeg|ffmpeg|ffmpeg|optional"
    "rclone|rclone|rclone|optional"
    "yt-dlp|yt-dlp|yt-dlp|optional"
    "watchman|watchman|watchman|optional"
    "sqlite|sqlite3|sqlite3|optional"
    "the_silver_searcher|ag|silversearcher-ag|optional"
  )

  local entry label bins pkg category b found remedy
  for entry in "${entries[@]}"; do
    IFS='|' read -r label bins pkg category <<< "$entry"

    # nvm provides node/npm on demand; don't nag about them when present.
    case "$label" in
      node|npm) have nvm && continue ;;
    esac

    found=false
    for b in $bins; do
      if have "$b"; then found=true; break; fi
    done
    if [[ "$found" == true ]]; then continue; fi

    if [[ "$CAN_APT" == true ]]; then
      remedy="apt could not provide '$pkg'; try Homebrew (brew install $pkg) or a static binary"
    else
      remedy="run 'sudo -v && script/setup' (or ask your admin) to: apt-get install -y $pkg"
    fi
    defer "$category" "$label" "not installed" "$remedy"
  done
}

# Aggressive user-local fallback: download musl static binaries from GitHub
# releases into ~/.local/bin (already on PATH) for tools that are still missing.
# Any failure is recorded via defer instead of aborting the run.
install_user_local_tools() {
  [[ "$OS" == "Linux" ]] || return 0
  have curl || return 0
  have python3 || return 0

  mkdir -p "$HOME/.local/bin"

  local arch
  case "$(uname -m)" in
    x86_64|amd64) arch="x86_64" ;;
    aarch64|arm64) arch="aarch64" ;;
    *) warn "unsupported arch for static binaries: $(uname -m)"; return 0 ;;
  esac

  # Per-arch asset entries: label|owner|repo|substr|binary|kind
  # kind: tar (.tar.gz/.tar.xz), zip, bin (single binary, no extraction).
  # substr must be specific enough to select the right archive (e.g. avoid
  # matching a .deb when a .tar.gz is also published).
  local entries
  if [[ "$arch" == "x86_64" ]]; then
    entries=(
      "rg|BurntSushi|ripgrep|x86_64-unknown-linux-musl|rg|tar"
      "fd|sharkdp|fd|x86_64-unknown-linux-musl|fd|tar"
      "bat|sharkdp|bat|x86_64-unknown-linux-musl|bat|tar"
      "eza|eza-community|eza|x86_64-unknown-linux-musl|eza|tar"
      "delta|dandavison|delta|x86_64-unknown-linux-musl|delta|tar"
      "dust|bootandy|dust|x86_64-unknown-linux-musl|dust|tar"
      "duf|muesli|duf|linux_x86_64|duf|tar"
      "btm|ClementTsang|bottom|x86_64-unknown-linux-musl|btm|tar"
      "zoxide|ajeetdsouza|zoxide|x86_64-unknown-linux-musl|zoxide|tar"
      "jq|jqlang|jq|linux-amd64|jq|bin"
      "yq|mikefarah|yq|linux_amd64|yq|bin"
      "gh|cli|cli|linux_amd64.tar.gz|gh|tar"
      "shellcheck|koalaman|shellcheck|linux.x86_64|shellcheck|tar"
      "shfmt|mvdan|shfmt|linux_amd64|shfmt|bin"
      "tldr|tlrc|tlrc|x86_64-unknown-linux-musl|tldr|zip"
      "direnv|direnv|direnv|linux-amd64|direnv|bin"
      "rclone|rclone|rclone|linux-amd64.zip|rclone|zip"
    )
  else
    entries=(
      "rg|BurntSushi|ripgrep|aarch64-unknown-linux-musl|rg|tar"
      "fd|sharkdp|fd|aarch64-unknown-linux-musl|fd|tar"
      "bat|sharkdp|bat|aarch64-unknown-linux-musl|bat|tar"
      "eza|eza-community|eza|aarch64-unknown-linux-musl|eza|tar"
      "delta|dandavison|delta|aarch64-unknown-linux-musl|delta|tar"
      "dust|bootandy|dust|aarch64-unknown-linux-musl|dust|tar"
      "duf|muesli|duf|linux_arm64|duf|tar"
      "btm|ClementTsang|bottom|aarch64-unknown-linux-musl|btm|tar"
      "zoxide|ajeetdsouza|zoxide|aarch64-unknown-linux-musl|zoxide|tar"
      "jq|jqlang|jq|linux-arm64|jq|bin"
      "yq|mikefarah|yq|linux_arm64|yq|bin"
      "gh|cli|cli|linux_arm64.tar.gz|gh|tar"
      "shellcheck|koalaman|shellcheck|linux.arm64|shellcheck|tar"
      "shfmt|mvdan|shfmt|linux_arm64|shfmt|bin"
      "tldr|tlrc|tlrc|aarch64-unknown-linux-musl|tldr|zip"
      "direnv|direnv|direnv|linux-arm64|direnv|bin"
      "rclone|rclone|rclone|linux-arm64.zip|rclone|zip"
    )
  fi

  local entry label owner repo sub binary kind
  for entry in "${entries[@]}"; do
    IFS='|' read -r label owner repo sub binary kind <<< "$entry"
    if have "$binary"; then continue; fi
    install_release_binary "$label" "$owner" "$repo" "$sub" "$binary" "$kind" || true
  done

  # uv: astral publishes unversioned musl assets under releases/latest/download.
  if ! have uv; then
    local uv_arch
    case "$(uname -m)" in
      x86_64|amd64) uv_arch="x86_64" ;;
      aarch64|arm64) uv_arch="aarch64" ;;
      *) uv_arch="" ;;
    esac
    if [[ -n "$uv_arch" ]]; then
      info "installing uv (user-local)"
      local tmp_dir
      tmp_dir="$(mktemp -d)"
      if curl -fsSL "https://github.com/astral-sh/uv/releases/latest/download/uv-${uv_arch}-unknown-linux-musl.tar.gz" -o "$tmp_dir/uv.tar.gz"; then
        tar -xzf "$tmp_dir/uv.tar.gz" -C "$tmp_dir" 2>/dev/null
        local uv_bin
        uv_bin="$(find "$tmp_dir" -type f -name uv -executable -print -quit 2>/dev/null || true)"
        if [[ -n "$uv_bin" ]]; then
          cp "$uv_bin" "$HOME/.local/bin/uv" && chmod +x "$HOME/.local/bin/uv"
          success "uv installed to ~/.local/bin"
        else
          defer "user-local" "uv" "download failed" "curl -LsSf https://astral.sh/uv/install.sh | sh"
        fi
      else
        defer "user-local" "uv" "download failed" "curl -LsSf https://astral.sh/uv/install.sh | sh"
      fi
      rm -rf "$tmp_dir"
    fi
  fi

  # node: use nvm if present and node is missing.
  if ! have node && have nvm; then
    info "installing node via nvm (lts)"
    # nvm is a shell function; load it for this invocation.
    local nvm_sh="$HOME/.nvm/nvm.sh"
    if [[ -s "$nvm_sh" ]]; then
      (
        # shellcheck source=/dev/null
        source "$nvm_sh"
        nvm install --lts >/dev/null 2>&1 && nvm use --lts >/dev/null 2>&1
      ) || defer "user-local" "node" "nvm install failed" "nvm install --lts"
    fi
  fi

  # httpie: pipx install if pipx is available and http is missing.
  if ! have http && have pipx; then
    info "installing httpie via pipx"
    pipx install httpie >/dev/null 2>&1 || defer "user-local" "httpie" "pipx install failed" "pipx install httpie"
  fi
}

# Claude Code CLI (~/.local/bin/claude), used by the `lclaude` wrapper. The
# official installer is user-local and needs no root, so this works in both
# install modes. Skipped silently if `claude` is already on PATH.
install_claude_code() {
  have curl || return 0
  if have claude; then return 0; fi

  info "installing claude (user-local)"
  if curl -fsSL https://claude.ai/install.sh | bash >/dev/null 2>&1; then
    success "claude installed to ~/.local/bin/claude"
  else
    defer "user-local" "claude" "install script failed" "curl -fsSL https://claude.ai/install.sh | bash"
  fi
}

# Resolve the browser_download_url of the latest release asset whose name
# contains <asset_substr>. Prints the URL on stdout; returns non-zero on failure.
resolve_asset_url() {
  local owner="$1" repo="$2" sub="$3"
  local api="https://api.github.com/repos/${owner}/${repo}/releases/latest"
  local json
  json="$(curl -fsSL "$api" 2>/dev/null)" || return 1
  printf '%s\n' "$json" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sub = sys.argv[1]
for a in d.get("assets", []):
    name = a.get("name", "")
    if sub in name:
        print(a.get("browser_download_url", ""))
        break
' "$sub" | grep -m1 -v '^$'
}

install_release_binary() {
  local label="$1" owner="$2" repo="$3" sub="$4" binary="$5" kind="$6"
  local url
  url="$(resolve_asset_url "$owner" "$repo" "$sub")" || {
    defer "user-local" "$label" "could not resolve release" "see https://github.com/${owner}/${repo}/releases"
    return 1
  }
  [[ -n "$url" ]] || {
    defer "user-local" "$label" "no matching release asset" "see https://github.com/${owner}/${repo}/releases"
    return 1
  }

  info "installing $label (user-local)"
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  local archive="$tmp_dir/asset"
  curl -fsSL "$url" -o "$archive" || {
    defer "user-local" "$label" "download failed" "see $url"
    rm -rf "$tmp_dir"
    return 1
  }

  local found=""
  case "$kind" in
    tar)
      tar -xf "$archive" -C "$tmp_dir" 2>/dev/null || true
      found="$(find "$tmp_dir" -type f -name "$binary" -print -quit 2>/dev/null || true)"
      ;;
    zip)
      have unzip || { defer "user-local" "$label" "unzip missing" "install unzip, then re-run"; rm -rf "$tmp_dir"; return 1; }
      unzip -oq "$archive" -d "$tmp_dir" 2>/dev/null || true
      found="$(find "$tmp_dir" -type f -name "$binary" -print -quit 2>/dev/null || true)"
      ;;
    bin)
      found="$archive"
      ;;
  esac

  if [[ -z "$found" ]]; then
    defer "user-local" "$label" "could not locate binary in archive" "see $url"
    rm -rf "$tmp_dir"
    return 1
  fi

  cp "$found" "$HOME/.local/bin/$binary" && chmod +x "$HOME/.local/bin/$binary"
  success "$label installed to ~/.local/bin/$binary"
  rm -rf "$tmp_dir"
}

install_linux_command_shims() {
  [[ "$OS" == "Linux" ]] || return 0

  mkdir -p "$HOME/.local/bin"

  if ! have fd && have fdfind; then
    ln -sfn "$(command -v fdfind)" "$HOME/.local/bin/fd"
    success "linked fd -> fdfind"
  fi

  if ! have bat && have batcat; then
    ln -sfn "$(command -v batcat)" "$HOME/.local/bin/bat"
    success "linked bat -> batcat"
  fi
}

install_linux_nerd_font() {
  [[ "$OS" == "Linux" ]] || return 0
  have curl || return 0
  have unzip || return 0

  local font_dir="$HOME/.local/share/fonts/JetBrainsMonoNerdFont"
  if find "$font_dir" -name "*JetBrainsMono*Nerd*Font*.ttf" -print -quit 2>/dev/null | grep -q .; then
    success "JetBrains Mono Nerd Font already installed"
    return
  fi

  info "installing JetBrains Mono Nerd Font"
  local tmp_dir
  tmp_dir="$(mktemp -d)"
  curl -fsSL https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.zip -o "$tmp_dir/JetBrainsMono.zip" || {
    warn "could not download JetBrains Mono Nerd Font"
    rm -rf "$tmp_dir"
    return
  }

  mkdir -p "$font_dir"
  unzip -oq "$tmp_dir/JetBrainsMono.zip" -d "$font_dir" || warn "could not unpack JetBrains Mono Nerd Font"
  rm -rf "$tmp_dir"
  have fc-cache && fc-cache -f "$HOME/.local/share/fonts" >/dev/null 2>&1 || true
}

install_linux_nvm() {
  [[ "$OS" == "Linux" ]] || return 0
  [[ -d "$HOME/.nvm/.git" ]] && return
  have git || return 0

  info "installing nvm"
  git clone https://github.com/nvm-sh/nvm.git "$HOME/.nvm" || warn "could not install nvm"
}

install_linux_miniforge() {
  [[ "$OS" == "Linux" ]] || return 0
  if have conda || [[ -x "$HOME/miniforge3/bin/conda" ]] || [[ -x "$HOME/miniconda3/bin/conda" ]]; then
    return
  fi
  have curl || return 0

  local arch
  case "$(uname -m)" in
    x86_64|amd64) arch="x86_64" ;;
    aarch64|arm64) arch="aarch64" ;;
    *) warn "unsupported Miniforge architecture: $(uname -m)"; return ;;
  esac

  info "installing Miniforge"
  local tmp_dir installer
  tmp_dir="$(mktemp -d)"
  installer="$tmp_dir/Miniforge3-Linux-${arch}.sh"
  curl -fsSL "https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-${arch}.sh" -o "$installer" || {
    warn "could not download Miniforge"
    rm -rf "$tmp_dir"
    return
  }
  bash "$installer" -b -p "$HOME/miniforge3" || warn "could not install Miniforge"
  rm -rf "$tmp_dir"

  if [[ -x "$HOME/miniforge3/bin/conda" ]]; then
    "$HOME/miniforge3/bin/conda" config --set auto_activate_base false >/dev/null 2>&1 || true
  fi
}

install_python_tools() {
  # Bootstrap pipx without sudo when possible (pipx wraps user-venv CLIs).
  if ! have pipx && have python3 && python3 -m pip --version >/dev/null 2>&1; then
    info "bootstrapping pipx (user install)"
    # Ubuntu 24.04+ blocks `pip install --user` via PEP 668
    # (externally-managed-environment). --break-system-packages is the
    # user-local override: it still installs to ~/.local, never touching the
    # system site-packages, so it is safe here. Without it pipx never lands and
    # powerline/uv/yt-dlp/httpie all stay deferred.
    python3 -m pip install --user --upgrade pipx >/dev/null 2>&1 \
      || python3 -m pip install --user --upgrade --break-system-packages pipx >/dev/null 2>&1 \
      || true
  fi

  if have pipx; then
    info "installing pipx tools"
    local powerline_python=""
    if have python3.13; then
      powerline_python="$(command -v python3.13)"
    elif have python3.12; then
      powerline_python="$(command -v python3.12)"
    elif have python3; then
      powerline_python="$(command -v python3)"
    fi

    pipx ensurepath --force >/dev/null 2>&1 || true
    if ! pipx list --short 2>/dev/null | grep -Eq "^powerline-status([[:space:]]|$)"; then
      if [[ -n "$powerline_python" ]]; then
        pipx install powerline-status --python "$powerline_python" || true
      else
        pipx install powerline-status || true
      fi
    fi
    pipx inject powerline-status powerline-gitstatus >/dev/null 2>&1 || true

    if [[ "$OS" == "Linux" ]]; then
      if ! have uv; then
        pipx install uv >/dev/null 2>&1 || true
      fi
      if ! have yt-dlp; then
        pipx install yt-dlp >/dev/null 2>&1 || true
      fi
    fi
  else
    warn "pipx unavailable; skipping Python CLI tools"
    defer "python" "pipx" "not installed" "python3 -m pip install --user --break-system-packages pipx  (or: sudo apt-get install -y pipx)"
  fi
}

install_powerline_config() {
  local config_dir target
  config_dir="${XDG_CONFIG_HOME:-$HOME/.config}"
  target="$config_dir/powerline"
  mkdir -p "$config_dir"

  if [[ -L "$target" || ! -e "$target" ]]; then
    ln -sfn "$DOTFILES_ROOT/powerline/config/powerline.symlink" "$target"
    success "powerline config"
  elif [[ -d "$target" ]]; then
    warn "existing Powerline config directory left in place: $target"
  fi
}

fzf_supports_zsh() {
  local fzf_bin="$1"
  [[ -n "$fzf_bin" && -x "$fzf_bin" ]] && "$fzf_bin" --zsh >/dev/null 2>&1
}

install_fzf_integration() {
  if [[ -x "$HOME/.fzf/bin/fzf" ]] && fzf_supports_zsh "$HOME/.fzf/bin/fzf"; then
    success "fzf integration (~/.fzf)"
    return
  fi

  if have fzf && fzf_supports_zsh "$(command -v fzf)"; then
    success "fzf integration (system)"
    return
  fi

  if [[ -d "$HOME/.fzf/.git" ]]; then
    info "updating ~/.fzf"
    git -C "$HOME/.fzf" pull --ff-only || true
  else
    info "installing ~/.fzf from upstream"
    git clone --depth 1 https://github.com/junegunn/fzf.git "$HOME/.fzf" || {
      warn "could not clone fzf"
      return
    }
  fi

  # Dotfiles owns ~/.zshrc and ~/.fzf.zsh; do not let fzf/install overwrite them.
  "$HOME/.fzf/install" --all --no-bash --no-fish --no-update-rc || warn "fzf install script failed"
}

# A tiny non-symlink ~/.zshrc is almost certainly a throwaway stub (fzf install
# stub, pipx/miniforge env stub, etc.) rather than a real user config. Treat it
# as safe to replace. A genuine user zshrc is usually far larger.
is_stub_zshrc() {
  local file="$1"
  [[ -f "$file" && ! -L "$file" ]] || return 1
  [[ $(wc -c <"$file") -lt 200 ]] || return 1
}

ensure_dotfiles_zshrc() {
  local dest="$HOME/.zshrc"
  local source="$DOTFILES_ROOT/zsh/zshrc.symlink"

  if [[ -L "$dest" && "$(readlink "$dest")" == "$source" ]]; then
    return
  fi

  if is_stub_zshrc "$dest"; then
    warn "replacing stub ~/.zshrc ($(wc -c <"$dest") bytes) with dotfiles zshrc"
    mv "$dest" "$dest.backup"
    success "backed up old ~/.zshrc to ~/.zshrc.backup"
    link_file "$source" "$dest"
  else
    warn "existing ~/.zshrc is not a stub; left in place (dotfiles zshrc not linked)"
  fi
}

setup_gitconfig() {
  cd "$DOTFILES_ROOT"

  if [[ -f git/gitconfig.symlink ]]; then
    return
  fi

  info "setup gitconfig"

  local git_credential="cache"
  if [[ "$OS" == "Darwin" ]]; then
    git_credential="osxkeychain"
  fi

  local git_authorname git_authoremail
  user "What is your github author name?"
  read -r git_authorname
  user "What is your github author email?"
  read -r git_authoremail

  sed \
    -e "s/AUTHORNAME/$git_authorname/g" \
    -e "s/AUTHOREMAIL/$git_authoremail/g" \
    -e "s/GIT_CREDENTIAL_HELPER/$git_credential/g" \
    git/gitconfig.symlink.example > git/gitconfig.symlink

  success "gitconfig"
}

link_file() {
  local source="$1"
  local dest="$2"

  ln -s "$source" "$dest"
  success "linked $source to $dest"
}

install_dotfiles() {
  cd "$DOTFILES_ROOT"
  info "installing dotfiles"

  local overwrite_all=false
  local backup_all=false
  local skip_all=false
  local source dest overwrite backup skip action

  while IFS= read -r source; do
    dest="$HOME/.${source##*/}"
    dest="${dest%.symlink}"

    if [[ -e "$dest" || -L "$dest" ]]; then
      if [[ -L "$dest" && "$(readlink "$dest")" == "$source" ]]; then
        success "already linked $dest"
        continue
      fi

      overwrite=false
      if [[ "$dest" == "$HOME/.zshrc" ]] && is_stub_zshrc "$dest"; then
        overwrite=true
      fi
      backup=false
      skip=false

      if [[ "$overwrite_all" == false && "$backup_all" == false && "$skip_all" == false ]]; then
        if [[ -t 0 ]]; then
          user "File exists: ${dest}. [s]kip, [S]kip all, [o]verwrite, [O]verwrite all, [b]ackup, [B]ackup all?"
          read -r -n 1 action
          printf "\n"
        else
          action="${DOTFILES_EXISTING_FILE_ACTION:-s}"
          warn "non-interactive run; defaulting existing file action for $dest to '$action'"
        fi

        case "$action" in
          o) overwrite=true ;;
          O) overwrite_all=true ;;
          b) backup=true ;;
          B) backup_all=true ;;
          s) skip=true ;;
          S) skip_all=true ;;
          *) skip=true ;;
        esac
      fi

      if [[ "$overwrite" == true || "$overwrite_all" == true ]]; then
        rm -rf "$dest"
        success "removed $dest"
      fi

      if [[ "$backup" == true || "$backup_all" == true ]]; then
        mv "$dest" "$dest.backup"
        success "moved $dest to $dest.backup"
      fi

      if [[ "$skip" == false && "$skip_all" == false ]]; then
        link_file "$source" "$dest"
      else
        success "skipped $source"
      fi
    else
      link_file "$source" "$dest"
    fi
  done < <(find "$DOTFILES_ROOT" -maxdepth 2 -name "*.symlink" -not -path "*/oh-my-zsh/*" | sort)
}

fix_zsh_permissions() {
  chmod -R go-w "$DOTFILES_ROOT/zsh" "$DOTFILES_ROOT/functions" 2>/dev/null || true
}

# Without root, zsh can't come from apt/brew. Miniforge (installed earlier in
# main()) provides conda-forge, so install zsh into the conda base env and link
# it onto PATH (~/.local/bin). Skipped silently if no conda is available; the
# missing-tool defer step reports it instead.
install_user_local_zsh() {
  [[ "$OS" == "Linux" ]] || return 0
  have zsh && return 0

  local conda_bin=""
  if [[ -x "$HOME/miniforge3/bin/conda" ]]; then
    conda_bin="$HOME/miniforge3/bin/conda"
  elif [[ -x "$HOME/miniconda3/bin/conda" ]]; then
    conda_bin="$HOME/miniconda3/bin/conda"
  elif have conda; then
    conda_bin="$(command -v conda)"
  else
    return 0
  fi

  info "installing zsh (user-local via conda)"
  if "$conda_bin" install -c conda-forge zsh -y >/dev/null 2>&1; then
    local conda_prefix zsh_bin
    conda_prefix="$("$conda_bin" info --base 2>/dev/null)"
    zsh_bin="$conda_prefix/bin/zsh"
    if [[ -x "$zsh_bin" ]]; then
      mkdir -p "$HOME/.local/bin"
      ln -sfn "$zsh_bin" "$HOME/.local/bin/zsh"
      success "zsh installed to $zsh_bin (linked at ~/.local/bin/zsh)"
    else
      defer "user-local" "zsh" "conda install ok but binary not found" "conda install -c conda-forge zsh"
    fi
  else
    defer "user-local" "zsh" "conda install failed" "conda install -c conda-forge zsh  (or build zsh from source)"
  fi
}

# No-root substitute for `chsh`: chsh needs the target in /etc/shells, which
# isn't editable without root. Instead, append a guarded exec into zsh to the
# bash startup files so interactive sessions drop into zsh. Idempotent.
install_zsh_shell_guard() {
  local zsh_path="$1"
  local marker="# >>> dotfiles: switch to zsh (no-root workaround) >>>"
  local end_marker="# <<< dotfiles: switch to zsh (no-root workaround) <<<"
  local file
  for file in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    [[ -f "$file" ]] || continue
    if grep -qF "$marker" "$file" 2>/dev/null; then
      continue
    fi
    {
      printf '\n%s\n' "$marker"
      printf '# Login shell cannot be changed without root (chsh needs /etc/shells entry),\n'
      printf '# so exec into zsh instead. Only fires for interactive TTY sessions.\n'
      printf 'if [ -t 1 ] && [ -z "${ZSH_VERSION:-}" ] && [ -x "%s" ]; then\n' "$zsh_path"
      printf '  exec "%s" -l\n' "$zsh_path"
      printf 'fi\n'
      printf '%s\n' "$end_marker"
    } >> "$file"
    success "added zsh exec guard to $file"
  done
}

set_default_shell() {
  local zsh_path
  zsh_path="$(command -v zsh || true)"
  [[ -n "$zsh_path" ]] || return

  if [[ "$HAS_SUDO" != true ]]; then
    if [[ "${SHELL:-}" != "$zsh_path" ]]; then
      install_zsh_shell_guard "$zsh_path"
      info "no root: login shell left as ${SHELL:-bash}; interactive shells exec into zsh"
      info "to set the real login shell later: add $zsh_path to /etc/shells, then chsh -s $zsh_path"
    fi
    return
  fi

  if ! grep -qx "$zsh_path" /etc/shells 2>/dev/null; then
    echo "$zsh_path" | run_as_root tee -a /etc/shells >/dev/null
  fi

  if [[ "${SHELL:-}" != "$zsh_path" ]]; then
    run_as_root chsh -s "$zsh_path" "$USER" || warn "could not change shell automatically"
  fi
}

restore_terminal() {
  [[ -t 1 ]] || return 0
  stty sane 2>/dev/null || true
  printf '\033[?25h\033[0m\033[?1049l' 2>/dev/null || true
}

install_topic_installers() {
  have git || fail "git is required for topic installers"

  info "running topic installers"
  find "$DOTFILES_ROOT" \
    -maxdepth 2 \
    -name install.sh \
    -not -path "$DOTFILES_ROOT/homebrew/*" \
    -not -path "$DOTFILES_ROOT/debian/*" \
    -print0 |
  while IFS= read -r -d '' installer; do
    echo "INSTALLING ${installer#"$DOTFILES_ROOT"/}"
    bash "$installer" </dev/null
    restore_terminal
  done
}

main() {
  cd "$DOTFILES_ROOT"
  detect_privileges
  resolve_install_mode
  defer_init

  if [[ "$INSTALL_MODE" == "sudo" ]]; then
    if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
      info "install mode: sudo (running as root)"
    else
      info "install mode: sudo (using cached sudo credentials)"
    fi
  else
    info "install mode: user-local (no sudo; system packages deferred where needed)"
  fi

  case "$OS" in
    Darwin) install_macos_packages ;;
    Linux) install_linux_packages ;;
    *) warn "unsupported OS for package installation: $OS" ;;
  esac

  install_python_tools
  install_powerline_config
  install_linux_command_shims
  install_linux_nerd_font
  install_linux_nvm
  install_linux_miniforge
  install_user_local_tools
  install_claude_code
  install_user_local_zsh
  defer_missing_linux_tools
  setup_gitconfig
  install_dotfiles
  ensure_dotfiles_zshrc
  install_fzf_integration
  fix_zsh_permissions
  set_default_shell
  install_topic_installers

  echo ""
  success "setup complete"
  echo "  Open a new shell or run: reload!"
  echo "  Explore features with: shell-help"
  echo ""
  echo "Deferred items (not installed; would improve UX):"
  print_deferred_report
}

main "$@"
