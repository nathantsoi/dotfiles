#!/usr/bin/env bash
#
# Run topic-specific dotfiles installers after bootstrap has installed packages.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DOTFILES_ROOT"

if ! command -v git >/dev/null 2>&1; then
  echo "git is required; run script/bootstrap first" >&2
  exit 1
fi

find . \
  -maxdepth 2 \
  -name install.sh \
  -not -path "./homebrew/*" \
  -not -path "./debian/*" \
  -print0 |
while IFS= read -r -d '' installer; do
  echo "INSTALLING $installer"
  bash "$installer"
done
